{
  "name": "stock-car-story",
  "version": "1.0.0",
  "description": "A stock car racing team management sim — build a team from a backyard garage to the Premier Cup.",
  "private": true,
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "build": "node tools/build.js",
    "icons": "node tools/make-icons.js",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios",
    "android:release": "cd android && ./gradlew bundleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  }
}
